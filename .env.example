# ── LLM Provider API Keys (server-side only) ──
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Provider Enable Flags ──
ENABLE_GEMINI=true
ENABLE_OPENAI=true
ENABLE_CLAUDE=true

# ── Ranking Weights (0.0–1.0, must sum to ~1.0) ──
LLM_WEIGHT=0.25
RETRIEVAL_WEIGHT=0.20
DIAGNOSIS_WEIGHT=0.20
CONTEXT_WEIGHT=0.15
EVIDENCE_WEIGHT=0.10
ML_WEIGHT=0.10

# ── Model Version ──
MODEL_VERSION=1.0.0

# ── Cost Control ──
LLM_TIMEOUT_MS=30000
MAX_INPUT_CHARS=5000
MAX_OUTPUT_TOKENS=2048

# ── Supabase (pre-populated by environment) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
